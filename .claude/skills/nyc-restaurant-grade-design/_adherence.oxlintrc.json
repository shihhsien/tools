{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/grade-lookup/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Liberation Sans Narrow))/i]",
        "message": "Font not provided by the design system. Available: Liberation Sans Narrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClosureBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|key|ref|className|style|children)$/]",
        "message": "<ClosureBanner> doesn't accept that prop. Declared props: date."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:grade|soft|size|key|ref|className|style|children)$/]",
        "message": "<GradeBadge> doesn't accept that prop. Declared props: grade, soft, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradePlacard'] > JSXAttribute > JSXIdentifier[name!=/^(?:grade|size|key|ref|className|style|children)$/]",
        "message": "<GradePlacard> doesn't accept that prop. Declared props: grade, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Input> variant must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|grade|score|type|closed|key|ref|className|style|children)$/]",
        "message": "<HistoryEntry> doesn't accept that prop. Declared props: date, grade, score, type, closed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logomark'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|grade|size|showWordmark|key|ref|className|style|children)$/]",
        "message": "<Logomark> doesn't accept that prop. Declared props: layout, grade, size, showWordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logomark'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:horizontal|stacked)$/]",
        "message": "<Logomark> layout must be one of 'horizontal' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:grade|name|address|score|gradedDate|inspectedDate|inspectionType|pending|meta|freshness|overdue|showContext|violations|history|closedDate|key|ref|className|style|children)$/]",
        "message": "<ResultCard> doesn't accept that prop. Declared props: grade, name, address, score, gradedDate, inspectedDate, inspectionType, pending, meta, freshness, overdue, showContext, violations, history, closedDate."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|grade|max|key|ref|className|style|children)$/]",
        "message": "<ScoreBar> doesn't accept that prop. Declared props: score, grade, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<StatusLine> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|error)$/]",
        "message": "<StatusLine> tone must be one of 'default' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trend'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|previous|key|ref|className|style|children)$/]",
        "message": "<Trend> doesn't accept that prop. Declared props: current, previous."
      },
      {
        "selector": "JSXOpeningElement[name.name='Violation'] > JSXAttribute > JSXIdentifier[name!=/^(?:desc|flag|code|category|key|ref|className|style|children)$/]",
        "message": "<Violation> doesn't accept that prop. Declared props: desc, flag, code, category."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
